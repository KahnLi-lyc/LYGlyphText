      "Consumer.swift": {
        "source": "import LYGlyphText\nimport SwiftUI\nimport UIKit\n\n/// 仅使用组件公开接口的独立接入样例；本轮只构建，不作为运行验收。\n@MainActor\nfinal class ConsumerSample {\n    let document: LYGlyphTextDocument\n    let attributedDocument: LYGlyphTextDocument\n    let provider: LYGlyphTextAttachmentViewProvider\n    private(set) var lastEvent: LYGlyphTextActionEvent?\n\n    init() throws {\n        let image = UIGraphicsImageRenderer(size: CGSize(width: 20, height: 20)).image { context in\n            UIColor.systemBlue.setFill()\n            context.fill(CGRect(x: 0, y: 0, width: 20, height: 20))\n        }\n        let attachment = LYGlyphTextAttachment(\n            id: \"image\", image: image, size: CGSize(width: 20, height: 20),\n            alignment: .center, alternativeText: \"图片\"\n        )\n        let view = LYGlyphTextViewAttachment(\n            id: \"button\", viewID: \"native-button\", size: CGSize(width: 72, height: 28),\n            alignment: .bottom, alternativeText: \"按钮\", isInteractive: true\n        )\n        document = try LYGlyphTextDocument(segments: [\n            .text(NSAttributedString(string: \"公开接口 👨‍👩‍👧‍👦 العربية\"), actionID: \"text\"),\n            .image(attachment),\n            .view(view)\n        ])\n        attributedDocument = try LYGlyphTextDocument(\n            attributedText: NSAttributedString(string: \"Legacy\"),\n            actions: [LYGlyphTextAction(actionID: \"legacy\", range: NSRange(location: 0, length: 6))]\n        )\n        provider = LYGlyphTextAttachmentViewProvider(\n            makeView: { description in\n                guard description.viewID == \"native-button\" else { return nil }\n                let button = UIButton(type: .system)\n                button.setTitle(\"原生按钮\", for: .normal)\n                return button\n            },\n            onUnmount: { _, view in view.accessibilityIdentifier = nil }\n        )\n    }\n\n    func record(_ event: LYGlyphTextActionEvent) {\n        lastEvent = event\n    }\n}\n\n@MainActor\nfinal class ConsumerUIKitController: UIViewController {\n    private let sample: ConsumerSample\n\n    init(sample: ConsumerSample) {\n        self.sample = sample\n        super.init(nibName: nil, bundle: nil)\n    }\n\n    @available(*, unavailable)\n    required init?(coder: NSCoder) { fatalError(\"请使用 init(sample:)\") }\n\n    override func viewDidLoad() {\n        super.viewDidLoad()\n        view.backgroundColor = .systemBackground\n        let label = LYGlyphTextLabel(frame: .zero)\n        label.document = sample.document\n        label.viewProvider = sample.provider\n        label.configuration.numberOfLines = 3\n        label.preferredMaxLayoutWidth = 280\n        label.onAction = { [weak sample] event in sample?.record(event) }\n        label.reloadAttachments()\n        let attributedLabel = LYGlyphTextLabel(frame: .zero)\n        attributedLabel.document = sample.attributedDocument\n        let stack = UIStackView(arrangedSubviews: [label, attributedLabel])\n        stack.axis = .vertical\n        stack.translatesAutoresizingMaskIntoConstraints = false\n        view.addSubview(stack)\n        NSLayoutConstraint.activate([\n            stack.leadingAnchor.constraint(equalTo: view.safeAreaLayoutGuide.leadingAnchor, constant: 20),\n            stack.trailingAnchor.constraint(equalTo: view.safeAreaLayoutGuide.trailingAnchor, constant: -20),\n            stack.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor, constant: 20)\n        ])\n    }\n}\n\n@MainActor\nstruct ConsumerSwiftUIView: View {\n    let sample: ConsumerSample\n\n    var body: some View {\n        LYGlyphTextView(\n            document: sample.document, configuration: .init(), viewProvider: sample.provider,\n            displayHeight: nil, onAction: { sample.record($0) }\n        )\n        .frame(width: 280)\n    }\n}\n\n@main\n@MainActor\nfinal class ConsumerAppDelegate: UIResponder, UIApplicationDelegate {\n    var window: UIWindow?\n\n    func application(\n        _ application: UIApplication,\n        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil\n    ) -> Bool {\n        do {\n            let sample = try ConsumerSample()\n            let tabs = UITabBarController()\n            tabs.viewControllers = [\n                ConsumerUIKitController(sample: sample),\n                UIHostingController(rootView: ConsumerSwiftUIView(sample: sample))\n            ]\n            let window = UIWindow(frame: UIScreen.main.bounds)\n            window.rootViewController = tabs\n            window.makeKeyAndVisible()\n            self.window = window\n            return true\n        } catch {\n            return false\n        }\n    }\n}\n",
        "sha256": "819f007a0c8113de128f6931a76eab56c55b5a64767ece8b942c29efa0125d6d"
